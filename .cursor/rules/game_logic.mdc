CREATE INDEX ON potions USING ivfflat (center_vector vector_l2_ops);
```

### Grimoires Table
```sql
CREATE TABLE grimoires (
  id UUID PRIMARY KEY,
  name VARCHAR(100) UNIQUE NOT NULL,
