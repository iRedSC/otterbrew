  value: number;
  appliedAt: timestamp;
  expiresAt: timestamp | null;
  sourcePotion: string;
}

interface UsedGrimoire {
  grimoireId: string;
  name: string;
  usedAt: timestamp;
  upgradesApplied: {
    stat: string;
    value: number;
  }[];
}

interface PlayerStats {
  potionsDiscovered: number;
  potionsBrewed: number;
  totalGoldEarned: number;
